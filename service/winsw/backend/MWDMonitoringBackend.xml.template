<service>
  <id>MWDMonitoringBackend</id>
  <name>MWD Monitoring Backend</name>
  <description>MWD Monitoring Backend API Service</description>
  <workingdirectory>{{BACKEND_DIR}}</workingdirectory>
  <executable>{{NODE_EXECUTABLE}}</executable>
  <arguments>{{BACKEND_START_ARGUMENTS}}</arguments>
  <env name="NODE_ENV" value="production"/>
  <env name="HOST" value="0.0.0.0"/>
  <env name="BACKEND_HOST" value="0.0.0.0"/>
  <env name="PORT" value="5001"/>
  <logpath>{{LOG_DIR}}</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec"/>
  <startmode>Automatic</startmode>
</service>
