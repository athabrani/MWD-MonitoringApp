# Root environment reference for local production-ready deployment.
# Copy and edit environment files inside each package:
#
#   mwd-app-be/.env.example -> mwd-app-be/.env
#   mwd-app-fe/.env.example -> mwd-app-fe/.env.local
#
# Backend local default:
#   http://localhost:5001
#   ws://localhost:5001/ws
#
# Frontend local default:
#   http://localhost:3000
#
# Do not put backend secrets in NEXT_PUBLIC_* frontend variables.
