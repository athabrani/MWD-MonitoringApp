// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Role")
}

model User {
  id           Int       @id @default(autoincrement())
  roleId       Int
  username     String    @unique @db.VarChar(100)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @db.VarChar(255)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role          Role            @relation(fields: [roleId], references: [id], onUpdate: Cascade)
  sessions      MWDSession[]
  exportRecords ExportRecord[]

  @@index([roleId])
  @@map("User")
}

model ConnectionStatus {
  id            Int       @id @default(autoincrement())
  source        String    @db.VarChar(100)
  status        String    @db.VarChar(30)
  description   String?   @db.Text
  checkedAt     DateTime  @default(now())
  responseMs    Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  failoverEvents FailoverEvent[]
  sessions       MWDSession[]
  websockets     Websocket[]

  @@index([status])
  @@index([checkedAt])
  @@map("Connection_Status")
}

model FailoverEvent {
  id                  Int       @id @default(autoincrement())
  connectionStatusId  Int
  fromNode            String?   @db.VarChar(100)
  toNode              String?   @db.VarChar(100)
  reason              String?   @db.Text
  eventAt             DateTime  @default(now())
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())

  connectionStatus ConnectionStatus @relation(fields: [connectionStatusId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([connectionStatusId])
  @@index([eventAt])
  @@map("Failover_event")
}

model MWDSession {
  id                  Int       @id @default(autoincrement())
  userId              Int
  connectionStatusId  Int?
  sessionCode         String    @unique @db.VarChar(100)
  wellName            String?   @db.VarChar(150)
  rigName             String?   @db.VarChar(150)
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  connectionStatus ConnectionStatus? @relation(fields: [connectionStatusId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  mwdData          MWDData[]
  exportRecords    ExportRecord[]

  @@index([userId])
  @@index([connectionStatusId])
  @@index([startedAt])
  @@map("MWD_Session")
}

model ExportRecord {
  id             Int       @id @default(autoincrement())
  sessionId      Int
  exportedById   Int
  fileName       String    @db.VarChar(255)
  fileType       String    @db.VarChar(50)
  filePath       String?   @db.VarChar(500)
  rowCount       Int?
  exportedAt     DateTime  @default(now())

  session        MWDSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  exportedBy     User       @relation(fields: [exportedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([sessionId])
  @@index([exportedById])
  @@index([exportedAt])
  @@map("Export_Record")
}

model MWDData {
  id            BigInt    @id @default(autoincrement())
  sessionId     Int
  measuredAt    DateTime
  depthMd       Decimal?  @db.Decimal(12, 4)
  inclination   Decimal?  @db.Decimal(8, 4)
  azimuth       Decimal?  @db.Decimal(8, 4)
  gammaRay      Decimal?  @db.Decimal(10, 4)
  rop           Decimal?  @db.Decimal(10, 4)
  hookLoad      Decimal?  @db.Decimal(10, 4)
  standpipePressure Decimal? @db.Decimal(10, 4)
  createdAt     DateTime  @default(now())

  session       MWDSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([sessionId])
  @@index([measuredAt])
  @@map("MWD_Data")
}

model Websocket {
  id                  Int       @id @default(autoincrement())
  connectionStatusId  Int?
  clientId            String?   @db.VarChar(120)
  channel             String?   @db.VarChar(100)
  isConnected         Boolean   @default(false)
  connectedAt         DateTime?
  disconnectedAt      DateTime?
  lastPingAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  connectionStatus ConnectionStatus? @relation(fields: [connectionStatusId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([connectionStatusId])
  @@index([clientId])
  @@map("Websocket")
}

