DATABASE_URL="postgresql://postgres:your_password@localhost:5432/mwd_db"
JWT_SECRET="YourJWTSecret"
CORS_ORIGIN="http://localhost:3000"
GATEWAY_API_KEY="replace_with_a_gateway_secret"

ESP_WS_URL="ws://192.168.4.1:81"
ESP_GATEWAY_SESSION_ID="1"
ESP_GATEWAY_SOURCE="esp32-websocket"
ESP_WS_RECONNECT_MS="5000"
ESP_WS_INGEST_TYPES="rx,tx_ws_only,raw"

SERIAL_GATEWAY_ENABLED="false"
SERIAL_PORT="COM9"
SERIAL_BAUD_RATE="115200"
SERIAL_GATEWAY_SESSION_ID="1"
SERIAL_GATEWAY_SOURCE="esp32-serial"
SERIAL_GATEWAY_RECONNECT_MS="5000"
SERIAL_GATEWAY_VERBOSE="false"

ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"

ENGINEER_USERNAME="engineer"
ENGINEER_EMAIL="engineer@example.com"
ENGINEER_PASSWORD="engineer12345"

SMTP_HOST=""
EMAIL_REPORTS_ENABLED="false"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_IGNORE_TLS="false"
SMTP_TLS_REJECT_UNAUTHORIZED="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MWD Monitoring <no-reply@example.com>"
SMTP_TIMEOUT_MS="30000"
