{
  "name": "mwd-monitoring-local-package",
  "private": true,
  "scripts": {
    "install:all": "cd mwd-app-be && npm install && cd ../mwd-app-fe && npm install",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm --prefix mwd-app-be run dev\" \"npm --prefix mwd-app-fe run dev\"",
    "dev:port-3001": "concurrently -n backend,frontend -c blue,green \"npm --prefix mwd-app-be run dev\" \"npm --prefix mwd-app-fe run dev:port-3001\"",
    "setup:local": "npm --prefix mwd-app-be run prisma:generate && npm --prefix mwd-app-be run prisma:migrate && npm --prefix mwd-app-be run build",
    "seed:local": "npm --prefix mwd-app-be run seed",
    "build": "npm --prefix mwd-app-be run build && npm --prefix mwd-app-fe run build",
    "start:local": "npm run build && concurrently -n backend,frontend -c blue,green \"npm --prefix mwd-app-be run start\" \"npm --prefix mwd-app-fe run start:port-3001\"",
    "start:local-session": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local-session.ps1",
    "check:local-session": "node ./scripts/check-local-session.mjs",
    "check:dev-ports": "node ./scripts/check-dev-ports.mjs",
    "start:mwd": "powershell -ExecutionPolicy Bypass -File ./scripts/start-mwd-app.ps1",
    "central:check": "powershell -ExecutionPolicy Bypass -File ./scripts/check-central-server.ps1",
    "central:check:local": "powershell -ExecutionPolicy Bypass -File ./scripts/check-central-server.ps1 -LocalOnly",
    "central:check:lan": "powershell -ExecutionPolicy Bypass -File ./scripts/check-central-server.ps1 -LanMode -ServerHost 192.168.18.75",
    "central:env:local": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-central-env.ps1 -LocalOnly -Apply",
    "central:env:lan": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-central-env.ps1 -LanMode -ServerHost 192.168.18.75 -Apply",
    "central:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-central-server.ps1",
    "central:start:local": "powershell -ExecutionPolicy Bypass -File ./scripts/start-central-server.ps1 -LocalOnly",
    "central:start:local:build": "powershell -ExecutionPolicy Bypass -File ./scripts/start-central-server.ps1 -LocalOnly -ForceBuild",
    "central:start:lan": "powershell -ExecutionPolicy Bypass -File ./scripts/start-central-server.ps1 -LanMode -ServerHost 192.168.18.75",
    "central:start:lan:build": "powershell -ExecutionPolicy Bypass -File ./scripts/start-central-server.ps1 -LanMode -ServerHost 192.168.18.75 -ForceBuild",
    "central:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-mwd-app.ps1 -StopPortListeners",
    "central:stop:safe": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-mwd-app.ps1",
    "central:reset:dryrun": "powershell -ExecutionPolicy Bypass -File ./scripts/reset-central-runtime.ps1 -DryRun",
    "central:reset": "powershell -ExecutionPolicy Bypass -File ./scripts/reset-central-runtime.ps1 -ConfirmStop",
    "central:shortcut": "powershell -ExecutionPolicy Bypass -File ./scripts/create-central-shortcut.ps1",
    "central:services:dryrun": "powershell -ExecutionPolicy Bypass -File ./scripts/install-central-services.ps1 -DryRun",
    "central:services:check": "powershell -ExecutionPolicy Bypass -File ./scripts/check-central-services.ps1",
    "central:firewall:dryrun": "powershell -ExecutionPolicy Bypass -File ./scripts/configure-central-firewall.ps1 -DryRun",
    "central:frontend:build": "powershell -ExecutionPolicy Bypass -File ./scripts/build-central-frontend.ps1",
    "central:package": "powershell -ExecutionPolicy Bypass -File ./scripts/prepare-central-server-package.ps1",
    "central:backup": "powershell -ExecutionPolicy Bypass -File ./scripts/backup-central-db.ps1",
    "start": "concurrently -n backend,frontend -c blue,green \"npm --prefix mwd-app-be run start\" \"npm --prefix mwd-app-fe run start\"",
    "clean": "rimraf mwd-app-be/dist mwd-app-fe/.next"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "rimraf": "^6.0.0"
  }
}
